# Frontend environment variables.

# Where the Next server proxies /api/* requests to.
#
# The frontend itself never calls this in the browser. The rewrite in
# next.config.ts forwards the request server-side, which is what keeps the
# session cookie same-origin: the browser only ever talks to this app's own
# host, so there is no cross-site cookie and no SameSite=None relaxation.
#
# Leave it unset and the app builds and runs exactly as before, with /api/*
# simply not being proxied. That is deliberate -- this file is read during
# `next build`, so a missing value must not fail the build.
#
# Local development, with the API on its own port:
#   API_ORIGIN=http://127.0.0.1:4000
#
# Production, from render.yaml's service URL:
#   API_ORIGIN=https://ncr-teams-api.onrender.com
API_ORIGIN=

# Where the browser opens its WebSocket.
#
# API_ORIGIN is not enough, and this is not a duplicate of it. The rewrite above
# proxies /api/*, and a rewrite cannot proxy a WebSocket upgrade -- so the socket
# has to be given the API's public host directly. The browser cannot derive it
# from API_ORIGIN, because that is a server-side variable and is never sent to
# the client.
#
# Leave it unset and the socket falls back to the page's own origin, which is
# correct only if one host serves both. In the split deployment (Vercel frontend,
# Render API) that host is Vercel, which will never complete the handshake --
# so the app logs a warning naming this variable rather than failing quietly.
#
# The scheme and path are derived for you: paste the API origin and it becomes a
# ws:// or wss:// URL with /ws appended.
#
# Local development, with the API on its own port:
#   NEXT_PUBLIC_WS_URL=ws://127.0.0.1:4000/ws
#
# Production, from render.yaml's service URL:
#   NEXT_PUBLIC_WS_URL=wss://ncr-teams-api.onrender.com/ws
#
# NEXT_PUBLIC_ variables are inlined at build time, so on Vercel this must be set
# before the build runs, not only at runtime.
NEXT_PUBLIC_WS_URL=

# Shown on the login page so a visitor can sign in without reading the README.
#
# Set these to match the password seeded by:
#   npm run demo:signin --workspace backend
#
# The password is public by design -- this is a showcase, and anyone who can load
# the page can sign in either way. It is in an env file rather than the component
# source so a real deployment is not shipping a default credential in git, and so
# a different environment can show a different one.
#
# Leave both blank and the hint is not rendered at all.
NEXT_PUBLIC_DEMO_EMAIL=
NEXT_PUBLIC_DEMO_PASSWORD=

# The LiveKit Cloud project URL, copied from the top of the LiveKit dashboard. It is
# the wss:// form, e.g.
#   wss://your-project-abc12.livekit.cloud
#
# This is the *only* LiveKit value the browser needs. The API key and secret stay on
# the server, which mints a short-lived join token per meeting; shipping a secret here
# would let anyone mint a token for any room.
#
# This is a NEXT_PUBLIC_ variable, so it is inlined at build time on Vercel -- set it
# and then redeploy, or the current build keeps the old value. Unset is supported: the
# meeting room falls back to a labelled simulated one instead of failing to join.
NEXT_PUBLIC_LIVEKIT_URL=

# Example environment for local development.
#
# Copy to `.env` and adjust. `.env` is gitignored; this file is not.
#
# These are throwaway development credentials, not secrets. The cluster under
# pgsql/ binds to 127.0.0.1 only, so it is unreachable from the network, and the
# data is disposable. Nothing here is reused for a deployed database -- a hosted
# instance gets its password from that provider's own environment settings.
#
# The port is 5433, not the default 5432, so this project's PostgreSQL never
# collides with another one already running on the machine.

# The application connects to this database as the role below.
DATABASE_URL="postgresql://ncr_app:ncr_app_local@127.0.0.1:5433/ncr_teams?schema=public"

# Superuser connection, used only by `npm run db:bootstrap` to create the role
# and database. The application never uses it.
POSTGRES_SUPERUSER_URL="postgresql://postgres:ncr_local_dev@127.0.0.1:5433/postgres"

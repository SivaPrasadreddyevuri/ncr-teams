# Repo-wide ignores.
# Frontend-specific Next.js entries live in frontend/.gitignore.

# dependencies
node_modules/

# build output
.next/
out/
build/
dist/

# testing
coverage/

# misc
.DS_Store
Thumbs.db
*.pem
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local

# Local PostgreSQL cluster.
#
# The whole of pgsql/ is ignored, not just its data directory: the 17.10
# binaries are ~97 MB of vendor files that belong in a release archive, and
# pgsql/data is a machine-local cluster that must never be committed. Scripts
# rebuild the cluster from ./pgsql with scripts\db-init.ps1.
pgsql/

# Uploaded file bytes.
#
# The database holds the metadata and this holds the bytes, and the bytes are
# reproducible: backend/scripts/materialise-demo-files.ts recreates the seeded
# files. Committing a var/ directory would mean a repository that grows with
# every upload someone makes.
backend/var/

# hosting
.vercel

# typescript
*.tsbuildinfo

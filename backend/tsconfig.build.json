{
  "extends": "./tsconfig.json",

  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "declaration": false
  },

  "include": ["src/**/*.ts"],

  /* Tests and one-off scripts are run through tsx, which resolves `.ts` itself,
     so they are deliberately outside the build. Including them would fail the
     compile: they import node:test and dev-only packages that are not installed
     in the production image. */
  "exclude": ["test", "scripts", "dist"]
}

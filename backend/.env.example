# Example environment for the API service.
#
# Copy to `.env`. `.env` is gitignored; this file is not.
#
# Nothing here has a default, including the session pepper. A service that boots
# with a shared fallback key is a service whose sessions are forgeable by anyone
# who has read the source, so a missing value is a boot failure rather than a
# default. See src/config.ts.

NODE_ENV=development
PORT=4000

# Pooled connection used for request handling.
#
# Locally this is the repository-local cluster on 5433 -- not 5432, so it cannot
# collide with another PostgreSQL on the machine.
DATABASE_URL="postgresql://ncr_app:ncr_app_local@127.0.0.1:5433/ncr_teams?schema=public"

# Unpooled connection, used by migrations and tests. On Neon this is the direct
# host, not the `-pooler` one: migrations issue DDL and read session state, and a
# transaction pooler breaks both.
DIRECT_DATABASE_URL="postgresql://ncr_app:ncr_app_local@127.0.0.1:5433/ncr_teams?schema=public"

# HMAC key for session tokens. Generate a fresh one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# Rotating this invalidates every existing session, which is the correct
# behaviour if it ever leaks.
SESSION_PEPPER=replace-me-with-32-plus-random-characters

SESSION_TTL_SECONDS=604800

# Origins allowed to send credentialed requests. Development only: in production
# the frontend proxies /api/* here, so requests are same-origin and this is
# unused.
CORS_ORIGINS=http://localhost:3000

# Reverse proxies in front of this service. 1 on Render, which terminates TLS and
# forwards one hop. Required to be at least 1 when NODE_ENV=production, because
# the session cookie is only Secure over HTTPS.
TRUST_PROXY_HOPS=0

# LiveKit Cloud credentials, from Settings > Keys in the LiveKit dashboard.
#
# These mint meeting join tokens. There is no project URL here on purpose: this service
# only signs tokens and never calls LiveKit, so the key and secret are all it needs.
# The browser gets the URL separately as NEXT_PUBLIC_LIVEKIT_URL.
#
# Both or neither. Unset is a supported state, not a misconfiguration: the token
# endpoint answers 503 and the meeting room falls back to a labelled simulated one.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
